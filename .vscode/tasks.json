{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Create host build directory",
            "type": "shell",
            "command": "mkdir",
            "args": [
                "-p",
                "${workspaceFolder}/build-host"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build active C file (host)",
            "type": "cppbuild",
            "command": "/usr/bin/gcc",
            "args": [
                "-std=c11",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-g3",
                "-O0",
                "-D_POSIX_C_SOURCE=200809L",
                "-I${workspaceFolder}/.vscode/host_include",
                "${file}",
                "-o",
                "${workspaceFolder}/build-host/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Create host build directory",
            "dependsOrder": "sequence",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build the active C file as a native Linux program without Pico hardware."
        }
    ]
}
